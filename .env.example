# HEATSHIELD AI — Production Environment Configuration
# Copy to .env.local for local development. NEVER commit .env.local to git.

# ─── Supabase (PostgreSQL Database) ──────────────────────────────────────────
# Used for: community reports, notification logs, audit logs, user profiles
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Firebase Authentication (Client SDK — Safe to expose) ───────────────────
# Get these from: Firebase Console → Project Settings → Your Apps → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789000
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789000:web:your-app-id

# ─── Firebase Admin SDK (SERVER-SIDE ONLY — NEVER expose to browser) ─────────
# Get from: Firebase Console → Project Settings → Service Accounts → Generate Private Key
# Paste the entire JSON string here (or use Vercel Environment Variables dashboard)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}

# ─── Open-Meteo Weather API (Free — No API Key Required) ──────────────────────
NEXT_PUBLIC_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# ─── Base URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Resend Transactional Email (SERVER-SIDE ONLY) ────────────────────────────
# NEVER use NEXT_PUBLIC_RESEND_API_KEY — that would expose it to the browser
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=HeatShield AI Alerts <alerts@heatshield.ai>

# ─── Twilio SMS Gateway (SERVER-SIDE ONLY) ────────────────────────────────────
# NEVER use NEXT_PUBLIC_TWILIO_* — that would expose credentials to the browser
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
