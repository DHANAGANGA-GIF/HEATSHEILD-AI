# HEATSHIELD AI — Production Environment Configuration
# Copy to .env.local for local development. NEVER commit .env.local to git.
# NEVER commit real secret values into this file.

# ─── Supabase (PostgreSQL Database) ──────────────────────────────────────────
# Used for: community reports, notification logs, audit logs, user profiles, OAuth token storage
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Firebase Authentication (Client SDK — Safe to expose) ───────────────────
# Get these from: Firebase Console → Project Settings → Your Apps → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789000
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789000:web:your-app-id

# ─── Firebase Admin SDK (SERVER-SIDE ONLY — NEVER expose to browser) ─────────
# Get from: Firebase Console → Project Settings → Service Accounts → Generate Private Key
# Paste the entire JSON string here (or use Vercel Environment Variables dashboard)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}

# ─── Open-Meteo Weather API (Free — No API Key Required) ──────────────────────
NEXT_PUBLIC_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# ─── Base URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email Provider Selection ─────────────────────────────────────────────────
# Set to 'gmail' to use Gmail API/OAuth (PRODUCTION, recommended)
# Set to 'resend' to use Resend transactional email service
EMAIL_PROVIDER=gmail

# ─── Gmail API / OAuth (PRODUCTION EMAIL — SERVER-SIDE ONLY) ─────────────────
# FINAL EMAIL CONTRACT:
#   FROM (sender):  GMAIL_SENDER_EMAIL  — fixed, never changes
#   TO (recipient): dynamically determined from authenticated user's verified Firebase email
#                   or subscriber's registered email for hourly dispatch
#
# IMPORTANT: The OAuth account that authorized the refresh token MUST match
#            GMAIL_SENDER_EMAIL exactly. If they differ, the provider reports NOT READY.
#
# Setup steps:
#   1. Create an OAuth Client ID in Google Cloud Console (Web Application type)
#   2. Add authorized redirect URI: https://your-app.vercel.app/api/email/google/callback
#   3. Visit /api/email/google/connect to authorize with dhanagangak@gmail.com
#   4. The refresh token is encrypted and stored automatically in Supabase oauth_tokens table
#   5. Alternatively, set GMAIL_REFRESH_TOKEN directly (see step 6 below)
#
GMAIL_SENDER_EMAIL=dhanagangak@gmail.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/email/google/callback  # optional override

# Gmail OAuth Refresh Token (Alternative to Supabase token storage)
# Obtain by completing the /api/email/google/connect OAuth flow, then copy from Supabase
# or set here if you already have it. NEVER commit the real token.
# GMAIL_REFRESH_TOKEN=your-gmail-oauth-refresh-token

# Optional: AES-256-GCM encryption key for refresh token storage in Supabase (32-byte hex)
# CRYPTO_KEY=your-64-character-hex-string

# ─── Resend Transactional Email (Alternative — SERVER-SIDE ONLY) ─────────────
# Only required if EMAIL_PROVIDER=resend
# NEVER use NEXT_PUBLIC_RESEND_API_KEY — that would expose it to the browser
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=HeatShield AI Alerts <alerts@heatshield.ai>

# ─── Cron / Hourly Dispatch Authorization ────────────────────────────────────
# Used by /api/cron/heat-risk-dispatch to verify scheduled invocations
# Set in Vercel: Project → Settings → Environment Variables
# Use a strong random secret: openssl rand -hex 32
CRON_SECRET=your-strong-random-cron-secret

# ─── Test / Development Overrides ────────────────────────────────────────────
# TEST_RECIPIENT_EMAIL: used by /api/email/test when invoked via CRON_SECRET
# TEST_RECIPIENT_EMAIL=your-test-inbox@gmail.com

# ─── Twilio SMS Gateway (SERVER-SIDE ONLY) ────────────────────────────────────
# NEVER use NEXT_PUBLIC_TWILIO_* — that would expose credentials to the browser
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
